# Environment Configuration for EVRaid Cloud

# Project Info
PROJECT_NAME="EVRaid Cloud Fleet Platform"
ENVIRONMENT=production
API_V1_STR=/v1

# TimescaleDB / PostgreSQL Credentials
POSTGRES_USER=evraid_admin
POSTGRES_PASSWORD=ReplaceWithStrongPassword_982!ev
POSTGRES_DB=evraid_cloud
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://evraid_admin:ReplaceWithStrongPassword_982!ev@timescaledb:5432/evraid_cloud

# Redis Hot State Cache
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Internal Webhook Security Token
INTERNAL_SYNC_TOKEN=evraid-warranty-sync-secret-key-change-in-production

# Web Dashboard API Base URL (Relative path '/v1' automatically proxies via Nginx on standard port 80/443)
NEXT_PUBLIC_API_URL=/v1
